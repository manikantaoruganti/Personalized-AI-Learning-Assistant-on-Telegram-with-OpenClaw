# Environment Variables for OpenClaw AI Learning Assistant

# --- Core OpenClaw Configuration ---
# LLM Provider: The provider for the Large Language Model.
# Options: "google", "openai", "ollama", etc.
LLM_PROVIDER="google"

# Model Name: The specific model to use from the chosen provider.
# For Google: "gemini-pro", "gemini-1.5-flash", "gemini-1.5-pro", etc.
# For Ollama: "llama3", "mistral", etc.
MODEL_NAME="gemini-1.5-flash"

# --- Telegram Plugin Configuration ---
# TELEGRAM_BOT_TOKEN: Your Telegram Bot API Token.
# Get this from BotFather on Telegram.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# --- Web Search Plugin Configuration ---
# SEARCH_PROVIDER: The provider for web search.
# Options: "serper", "serpapi", "tavily", etc.
SEARCH_PROVIDER="tavily" # Example: tavily, serper, serpapi

# SEARCH_ENDPOINT: The API endpoint for the search provider (if custom).
# For Tavily, Serper, SerpAPI, this is usually not needed or defaults.
# If using a custom endpoint, specify it here.
# SEARCH_ENDPOINT="https://api.tavily.com/search"

# SEARCH_API_KEY: Your API key for the chosen web search provider.
SEARCH_API_KEY="YOUR_WEB_SEARCH_API_KEY"

# --- Automation Configuration ---
# TIMEZONE: The timezone for cron-scheduled automations (e.g., daily tech brief).
# Use standard IANA Time Zone Database names (e.g., "America/New_York", "Europe/London", "Asia/Tokyo").
TIMEZONE="America/New_York" # IMPORTANT: Set your local timezone
